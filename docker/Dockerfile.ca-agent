FROM smallstep/step-cli:0.31.0 AS step
FROM python:3.14.5-alpine3.22
ARG NETADMIN_VERSION=unknown
ENV NETADMIN_VERSION=${NETADMIN_VERSION}
HEALTHCHECK --interval=30s --timeout=15s --start-period=30s --retries=3 CMD python3 -m netadmin.health --kind ca --port 8084
COPY --from=step /usr/local/bin/step /usr/local/bin/step
WORKDIR /app
COPY pyproject.toml /app/
COPY netadmin /app/netadmin
RUN pip install --no-cache-dir --only-binary :all: .
EXPOSE 8084
CMD ["sh", "-c", "exec gunicorn --no-control-socket --bind 0.0.0.0:8084 --workers 1 --timeout 90 --certfile /pki/server.crt --keyfile /pki/server.key --ca-certs /pki/ca.crt --cert-reqs 2 'netadmin.agents.ca:create_ca_agent()'"]
