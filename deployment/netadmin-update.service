[Unit]
Description=Release-aware NetAdmin cohort update
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Copy/edit this example; Python and plan paths must match your installation.
ExecStart=/opt/netadmin/.venv/bin/python -m netadmin.operations.update --plan /etc/netadmin/update-plan.json --password-file /etc/netadmin/recovery-passphrase
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
